{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "california-refresh-website",
  "compatibility_date": "2026-04-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Unknown paths get the nearest 404.html (es/404.html under /es/) with a 404 status.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
